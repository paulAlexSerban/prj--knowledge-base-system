// Collector for the POC. Metrics are remote-written to Prometheus.
// Logs are pushed to Loki. Traces arrive on OTLP and are exported to Tempo.
//
// Loki labels are only service, trust_area, level, and source_id.
// request_id, principal, chunk_id, trace_id, and span_id stay in the JSON line.

logging {
  level = "info"
}

discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
}

discovery.relabel "containers" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "kbs.*"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  // Feature logs only. A missing service label is not kept. Metrics scrapes
  // of the other processes are unchanged.
  rule {
    source_labels = ["service"]
    regex         = "gateway-api|gateway-mcp|webhook-receiver|ingestion-worker|connector-hr|connector-engineering|connector-sales|connector-product|harness-hr|harness-sales|harness-product|harness-engineering|chat-ui"
    action        = "keep"
  }
}

loki.source.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.docker.containers.targets
  relabel_rules    = discovery.relabel.containers.rules
  forward_to       = [loki.relabel.features.receiver]
  refresh_interval = "5s"
}

// Second gate. A line with no service label, or from a process that is not
// a feature, is dropped here even if the target filter missed it.
loki.relabel "features" {
  forward_to = [loki.process.kbs.receiver]

  rule {
    source_labels = ["service"]
    regex         = "gateway-api|gateway-mcp|webhook-receiver|ingestion-worker|connector-hr|connector-engineering|connector-sales|connector-product|harness-hr|harness-sales|harness-product|harness-engineering|chat-ui"
    action        = "keep"
  }
}

loki.process "kbs" {
  forward_to = [loki.write.local.receiver]

  // Probes are not a feature. /changes, /ids, and /v1/search stay.
  stage.drop {
    expression          = "\"(GET|HEAD) /(health|metrics|ready|live|-/healthy|-/ready|_stcore/health)|\\\"path\\\": ?\\\"/(health|metrics|ready|live|_stcore)"
    drop_counter_reason = "operational_probe"
  }

  stage.json {
    expressions = {
      level      = "level",
      source_id  = "source_id",
      trust_area = "trust_area",
    }
  }

  stage.labels {
    values = {
      level      = "",
      source_id  = "",
      trust_area = "",
    }
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

prometheus.remote_write "local" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

// job is the Compose service name. Copy it to service so metrics use the
// same name as the Loki label. trust_area matches shared.logging.configure.
// trace_id and span_id stay out of labels.
prometheus.relabel "kbs" {
  forward_to = [prometheus.remote_write.local.receiver]

  rule {
    source_labels = ["job"]
    target_label  = "service"
  }

  rule {
    source_labels = ["job"]
    regex         = "gateway-api|gateway-mcp"
    target_label  = "trust_area"
    replacement   = "access"
  }

  rule {
    source_labels = ["job"]
    regex         = "webhook-receiver|harness-hr|harness-sales|harness-product|harness-engineering"
    target_label  = "trust_area"
    replacement   = "sources"
  }

  rule {
    source_labels = ["job"]
    regex         = "connector-hr|connector-sales|connector-product|connector-engineering|ingestion-worker"
    target_label  = "trust_area"
    replacement   = "ingestion"
  }

  rule {
    source_labels = ["job"]
    regex         = "chat-ui"
    target_label  = "trust_area"
    replacement   = "frontend"
  }
}

// Applications export OTLP to Alloy. Tempo is the only trace store.
otelcol.receiver.otlp "kbs" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    traces = [otelcol.processor.filter.features.input]
  }
}

// Drop probe spans and FastAPI's internal handler spans. A feature span stays,
// including client and server spans the service graph needs: harness.get,
// product.hook, acl.recheck.http, chat.gateway.ask, and GET or POST feature
// routes. sqs.publish and sqs.consume stay too. The name filter does not drop those.
otelcol.processor.filter "features" {
  error_mode = "ignore"

  traces {
    span = [
      "IsMatch(name, \"^(GET|HEAD|POST) /(health|metrics)\")",
      "IsMatch(name, \"^(GET|HEAD) /(ready|live|-/healthy|-/ready|_stcore/health)\")",
      "IsMatch(name, \"^fastapi($|\\\\.)\")",
    ]
  }

  output {
    traces = [otelcol.processor.batch.kbs.input]
  }
}

otelcol.processor.batch "kbs" {
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}

prometheus.scrape "gateway_api" {
  targets         = [{__address__ = "gateway-api:8000"}]
  job_name        = "gateway-api"
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.kbs.receiver]
}

prometheus.scrape "gateway_mcp" {
  targets         = [{__address__ = "gateway-mcp:8001"}]
  job_name        = "gateway-mcp"
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.kbs.receiver]
}

// Connector metrics are defined in observability/metrics.md.
prometheus.scrape "connector_hr" {
  targets         = [{__address__ = "connector-hr:9100"}]
  job_name        = "connector-hr"
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.kbs.receiver]
}

prometheus.scrape "connector_engineering" {
  targets         = [{__address__ = "connector-engineering:9102"}]
  job_name        = "connector-engineering"
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.kbs.receiver]
}

prometheus.scrape "connector_sales" {
  targets         = [{__address__ = "connector-sales:9103"}]
  job_name        = "connector-sales"
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.kbs.receiver]
}

prometheus.scrape "connector_product" {
