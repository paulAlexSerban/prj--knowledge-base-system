  job_name        = "ingestion-worker"
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.kbs.receiver]
}

prometheus.scrape "webhook_receiver" {
  targets         = [{__address__ = "webhook-receiver:8090"}]
  job_name        = "webhook-receiver"
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.kbs.receiver]
}

prometheus.scrape "harness_hr" {
  targets         = [{__address__ = "harness-hr:8080"}]
  job_name        = "harness-hr"
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.kbs.receiver]
}

prometheus.scrape "harness_sales" {
  targets         = [{__address__ = "harness-sales:8080"}]
  job_name        = "harness-sales"
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.kbs.receiver]
}

prometheus.scrape "harness_product" {
  targets         = [{__address__ = "harness-product:8080"}]
  job_name        = "harness-product"
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.kbs.receiver]
