prometheus.scrape "webhook_receiver" {
  targets         = [{__address__ = "webhook-receiver:8090"}]
  job_name        = "webhook-receiver"
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.kbs.receiver]
