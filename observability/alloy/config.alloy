// jupyter publishes no /metrics endpoint and is intentionally not scraped.

prometheus.scrape "harness_engineering" {
  targets         = [{__address__ = "harness-engineering:8080"}]
  job_name        = "harness-engineering"
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.kbs.receiver]
}
