}

// Streamlit has no /metrics on 8501. The page listens on 9105 for this scrape.
prometheus.scrape "chat_ui" {
  targets         = [{__address__ = "chat-ui:9105"}]
  job_name        = "chat-ui"
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.kbs.receiver]
}

// jupyter publishes no /metrics endpoint and is intentionally not scraped.
