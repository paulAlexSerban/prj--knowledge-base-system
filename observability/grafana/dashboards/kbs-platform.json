{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "kbs-platform"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "builtIn": true,
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "query": {
            "datasource": {
              "name": "-- Grafana --"
            },
            "group": "grafana",
            "kind": "DataQuery",
            "spec": {},
            "version": "v0"
          }
        }
      }
    ],
    "cursorSync": "Off",
    "editable": true,
    "elements": {
      "panel-60": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "prometheus",
                        "uid": "prometheus"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "up{job=~\"alloy|loki|prometheus\"}",
                        "legendFormat": "{{job}}"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "1 means Prometheus scraped Alloy, Loki, or itself. Target is 1. Red at 0. A red target means this board is missing metrics or logs. Application targets stay on the overview.",
          "id": 60,
          "links": [],
          "title": "Observability targets (up)",
          "vizConfig": {
            "group": "stat",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "red",
                        "value": 0
                      },
                      {
                        "color": "green",
                        "value": 1
                      }
                    ]
                  }
                },
                "overrides": []
              },
              "options": {
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "auto",
                "percentChangeColorMode": "standard",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showPercentChange": false,
                "textMode": "value_and_name",
                "wideLayout": true
              }
            },
            "version": "13.2.3"
          }
        }
      },
      "panel-61": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "prometheus",
                        "uid": "prometheus"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "kbs_worker_dependency_up",
                        "legendFormat": "worker {{dependency}}"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "prometheus",
                        "uid": "prometheus"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "kbs_connector_dependency_up",
                        "legendFormat": "connector {{job}} {{dependency}}"
                      },
                      "version": "v0"
                    },
                    "refId": "B"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "1 when a dependency answered. Target is 1. Red at 0. Worker dependencies are Postgres, Neo4j, S3, and SQS. Connector dependencies are Postgres, S3, the harness, and SQS. S3 and SQS are floci. A red dependency stops sync or ingestion.",
          "id": 61,
          "links": [],
          "title": "Store and queue dependencies (up)",
          "vizConfig": {
            "group": "stat",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "red",
                        "value": 0
                      },
                      {
                        "color": "green",
                        "value": 1
                      }
                    ]
                  }
                },
                "overrides": []
              },
              "options": {
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "auto",
                "percentChangeColorMode": "standard",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showPercentChange": false,
                "textMode": "value_and_name",
                "wideLayout": true
              }
            },
            "version": "13.2.3"
          }
        }
      },
      "panel-62": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "loki",
                        "uid": "loki"
                      },
                      "group": "loki",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "{service=~\"$service\"} | json | level=\"error\"",
                        "queryType": "range"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Error lines from every service. The service variable filters them. There is no color threshold. Use this when a dependency is red or a scrape target is down. The line has no snippet and no secret.",
          "id": 62,
          "links": [],
          "title": "Error logs",
          "vizConfig": {
            "group": "logs",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              },
              "options": {
                "dedupStrategy": "none",
                "enableInfiniteScrolling": false,
                "enableLogDetails": true,
                "prettifyLogMessage": false,
                "showCommonLabels": false,
                "showControls": false,
                "showFieldSelector": false,
                "showLabels": true,
                "showLevel": true,
                "showTime": true,
                "sortOrder": "Descending",
                "timestampResolution": "ms",
                "unwrappedColumns": false,
                "wrapLogMessage": true
              }
            },
            "version": "13.2.3"
          }
        }
      }
    },
    "layout": {
      "kind": "RowsLayout",
      "spec": {
        "rows": [
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "collapse": false,
              "title": "Platform",
              "layout": {
                "kind": "GridLayout",
                "spec": {
                  "items": [
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-60"
                        },
                        "x": 0,
                        "y": 0,
                        "width": 12,
                        "height": 6
                      }
                    },
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-61"
                        },
                        "x": 12,
                        "y": 0,
                        "width": 12,
                        "height": 6
                      }
                    },
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-62"
                        },
                        "x": 0,
                        "y": 6,
                        "width": 24,
                        "height": 10
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "links": [
      {
        "title": "Overview",
        "type": "link",
        "icon": "external link",
        "tooltip": "SLO, target health, and the latest errors and denies",
        "url": "/d/kbs-overview/kbs-overview",
        "tags": [],
        "asDropdown": false,
        "targetBlank": false,
        "includeVars": true,
        "keepTime": true
      },
      {
        "title": "Ingestion",
        "type": "link",
        "icon": "external link",
        "tooltip": "Per-source sync, queues, store writes, and product hooks",
        "url": "/d/kbs-ingestion/kbs-ingestion",
        "tags": [],
        "asDropdown": false,
        "targetBlank": false,
        "includeVars": true,
        "keepTime": true
      },
      {
        "title": "Retrieval and access",
        "type": "link",
        "icon": "external link",
        "tooltip": "HTTP, search latency, empty results, and denies",
        "url": "/d/kbs-retrieval-access/kbs-retrieval-access",
        "tags": [],
        "asDropdown": false,
        "targetBlank": false,
        "includeVars": true,
        "keepTime": true
      }
    ],
    "liveNow": false,
    "preload": false,
    "tags": [
      "kbs",
      "platform"
    ],
    "timeSettings": {
      "autoRefresh": "",
      "autoRefreshIntervals": [
        "5s",
        "10s",
        "30s",
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "2h",
        "1d"
      ],
      "fiscalYearStartMonth": 0,
      "from": "now-15m",
      "hideTimepicker": false,
      "timezone": "browser",
      "to": "now"
    },
    "title": "KBS / Platform",
    "variables": [
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "service",
          "label": "Service",
          "description": "Filters the error and deny log panel. All keeps every service. The value is .+ because Loki rejects an empty-matching .*.",
          "hide": "dontHide",
          "refresh": "onDashboardLoad",
          "skipUrlSync": false,
          "current": {
            "text": "All",
            "value": "$__all"
          },
          "options": [],
          "regex": "",
          "sort": "alphabeticalAsc",
          "multi": true,
          "includeAll": true,
          "allValue": ".+",
          "allowCustomValue": false,
          "query": {
            "kind": "DataQuery",
            "group": "prometheus",
            "version": "v0",
            "datasource": {
              "name": "prometheus",
              "uid": "prometheus"
            },
            "spec": {
              "query": "label_values(up, job)",
              "refId": "A"
            }
          }
        }
      }
    ]
  }
}
