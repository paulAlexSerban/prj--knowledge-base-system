      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Span rate",
          "description": "Finished spans per second for the four harnesses. A gap means no traffic, or Tempo has not remote-written span metrics yet.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "refId": "A",
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus",
                        "uid": "prometheus"
                      },
                      "spec": {
                        "expr": "sum by (span_name) (rate(traces_spanmetrics_calls_total{service=~\"harness-hr|harness-sales|harness-product|harness-engineering\"}[5m]))",
                        "legendFormat": "{{span_name}}"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
