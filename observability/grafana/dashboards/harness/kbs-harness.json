      "panel-11": {
        "kind": "Panel",
        "spec": {
          "id": 11,
          "title": "Recent traces",
          "description": "Feature requests to a harness. Connector calls and the ACL re-check land here. Probes are left out.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "refId": "A",
                    "query": {
                      "kind": "DataQuery",
                      "group": "tempo",
                      "version": "v0",
                      "datasource": {
                        "name": "tempo",
                        "uid": "tempo"
                      },
                      "spec": {
                        "filters": [],
                        "limit": 20,
                        "query": "{ resource.service.name =~ \"harness-hr|harness-sales|harness-product|harness-engineering\" && rootName !~ \"^(GET|HEAD|POST) /(health|metrics).*\" }",
                        "queryType": "traceql",
                        "tableType": "traces"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.2.3",
            "spec": {
