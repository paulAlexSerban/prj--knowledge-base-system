      "panel-3": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "loki",
                        "uid": "loki"
                      },
                      "group": "loki",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "{service=~\"$service\"} | json | level=\"error\"",
                        "queryType": "range"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
