                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "loki",
                        "uid": "loki"
                      },
                      "group": "loki",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "{service=~\"$service\"} | json | decision=\"deny\"",
                        "queryType": "range"
                      },
                      "version": "v0"
                    },
                    "refId": "B"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Error lines, and lines whose decision is deny, from the gateway, connectors, worker, harnesses, and chat page. Health, metrics, collector, store, and floci lines are not in Loki. The service variable filters both. There is no color threshold. A deny is demo step 2: open the line and follow request_id. An error line is a failed sync, enqueue, or store write. The line has no snippet and no secret.",
          "id": 3,
          "links": [],
          "title": "Errors and denies",
          "vizConfig": {
            "group": "logs",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              },
              "options": {
                "dedupStrategy": "none",
                "enableInfiniteScrolling": false,
                "enableLogDetails": true,
                "prettifyLogMessage": false,
                "showCommonLabels": false,
                "showControls": false,
                "showFieldSelector": false,
                "showLabels": true,
                "showLevel": true,
                "showTime": true,
                "sortOrder": "Descending",
                "timestampResolution": "ms",
                "unwrappedColumns": false,
                "wrapLogMessage": true
