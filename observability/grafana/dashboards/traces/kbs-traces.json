{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "kbs-traces"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "builtIn": true,
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "query": {
            "datasource": {
              "name": "-- Grafana --"
            },
            "group": "grafana",
            "kind": "DataQuery",
            "spec": {},
            "version": "v0"
          }
        }
      }
    ],
    "cursorSync": "Off",
    "editable": true,
    "elements": {
      "panel-70": {
        "kind": "Panel",
        "spec": {
          "id": 70,
          "title": "Recent traces",
          "description": "Feature traces for the selected service. Health checks, metrics scrapes, and readiness probes are left out. There is no service map. The trace id cell opens the trace. A missing row means the process has no OTEL_EXPORTER_OTLP_ENDPOINT, Alloy is down, or only probes ran.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "refId": "A",
                    "query": {
                      "kind": "DataQuery",
                      "group": "tempo",
                      "version": "v0",
                      "datasource": {
                        "name": "tempo",
                        "uid": "tempo"
                      },
                      "spec": {
                        "filters": [],
                        "limit": 20,
                        "query": "{ resource.service.name =~ \"$service\" && rootName !~ \"^(GET|HEAD|POST) /(health|metrics).*\" && rootName !~ \"^(GET|HEAD) /(ready|live|-/healthy|-/ready|_stcore/health).*\" }",
                        "queryType": "traceql",
                        "tableType": "traces"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.2.3",
            "spec": {
              "options": {
                "cellHeight": "sm",
                "showHeader": true,
                "footer": {
                  "countRows": false,
                  "enablePagination": false,
                  "fields": "",
                  "reducer": ["sum"],
                  "show": false
                }
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "panel-71": {
        "kind": "Panel",
        "spec": {
          "id": 71,
          "title": "Search spans slower than 250 ms",
          "description": "Retrieval spans over the 250 ms target. The trace id cell opens the trace. Compare it with the Retrieval and access latency panel. No rows means search is inside the target or nobody searched.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "refId": "A",
                    "query": {
                      "kind": "DataQuery",
                      "group": "tempo",
                      "version": "v0",
                      "datasource": {
                        "name": "tempo",
                        "uid": "tempo"
                      },
                      "spec": {
                        "filters": [],
                        "limit": 20,
                        "query": "{ resource.service.name =~ \"$service\" && name = \"retrieval\" && duration > 250ms }",
                        "queryType": "traceql",
                        "tableType": "traces"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.2.3",
            "spec": {
              "options": {
                "cellHeight": "sm",
                "showHeader": true,
                "footer": {
                  "countRows": false,
                  "enablePagination": false,
                  "fields": "",
                  "reducer": ["sum"],
                  "show": false
                }
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "panel-72": {
        "kind": "Panel",
        "spec": {
          "id": 72,
          "title": "Error spans",
          "description": "Feature spans marked error. Health checks, metrics scrapes, and readiness probes are left out. The trace id cell opens the trace, then the log line with the same trace id. A deny is not an error span. An error here is a failed call, a store exception, or an HTTP 5xx.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "refId": "A",
                    "query": {
                      "kind": "DataQuery",
                      "group": "tempo",
                      "version": "v0",
                      "datasource": {
                        "name": "tempo",
                        "uid": "tempo"
                      },
                      "spec": {
                        "filters": [],
                        "limit": 20,
                        "query": "{ resource.service.name =~ \"$service\" && status = error && rootName !~ \"^(GET|HEAD|POST) /(health|metrics).*\" && rootName !~ \"^(GET|HEAD) /(ready|live|-/healthy|-/ready|_stcore/health).*\" }",
                        "queryType": "traceql",
                        "tableType": "traces"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.2.3",
            "spec": {
              "options": {
                "cellHeight": "sm",
                "showHeader": true,
                "footer": {
                  "countRows": false,
                  "enablePagination": false,
                  "fields": "",
                  "reducer": ["sum"],
                  "show": false
                }
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      }
    },
    "layout": {
      "kind": "RowsLayout",
      "spec": {
        "rows": [
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "collapse": false,
              "hideHeader": false,
              "title": "Traces",
              "layout": {
                "kind": "GridLayout",
                "spec": {
                  "items": [
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "x": 0,
                        "y": 0,
                        "width": 24,
                        "height": 10,
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-70"
                        }
                      }
                    },
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "x": 0,
                        "y": 10,
                        "width": 12,
                        "height": 10,
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-71"
                        }
                      }
                    },
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "x": 12,
                        "y": 10,
                        "width": 12,
                        "height": 10,
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-72"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "links": [
      {
        "title": "Ingestion",
        "type": "link",
        "icon": "external link",
        "tooltip": "Per-source sync, queues, store writes, and product hooks",
        "url": "/d/kbs-ingestion/kbs-ingestion",
        "tags": [],
        "asDropdown": false,
        "targetBlank": false,
        "includeVars": true,
        "keepTime": true
      },
      {
        "title": "Retrieval and access",
        "type": "link",
        "icon": "external link",
        "tooltip": "HTTP, search latency, empty results, and denies",
        "url": "/d/kbs-retrieval-access/kbs-retrieval-access",
        "tags": [],
        "asDropdown": false,
        "targetBlank": false,
        "includeVars": true,
        "keepTime": true
      }
    ],
    "liveNow": false,
    "preload": false,
    "tags": ["kbs", "traces"],
    "timeSettings": {
      "autoRefresh": "",
      "autoRefreshIntervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"],
      "fiscalYearStartMonth": 0,
      "from": "now-15m",
      "hideTimepicker": false,
      "timezone": "browser",
      "to": "now"
    },
    "title": "KBS / Traces",
    "variables": [
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "service",
          "label": "Service",
          "description": "TraceQL filter on resource.service.name. All is .+ so an empty match is not sent.",
          "hide": "dontHide",
          "refresh": "onDashboardLoad",
          "skipUrlSync": false,
          "current": {
            "text": "All",
            "value": "$__all"
          },
          "options": [],
          "regex": "",
          "sort": "alphabeticalAsc",
          "multi": false,
          "includeAll": true,
          "allValue": ".+",
          "allowCustomValue": false,
          "query": {
            "kind": "DataQuery",
            "group": "prometheus",
            "version": "v0",
            "datasource": {
              "name": "prometheus",
              "uid": "prometheus"
            },
            "spec": {
              "query": "label_values(up, job)",
              "refId": "A"
            }
          }
        }
      }
    ]
  }
}
