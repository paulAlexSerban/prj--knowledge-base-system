{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "kbs-traces"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "builtIn": true,
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "query": {
            "datasource": {
              "name": "-- Grafana --"
            },
            "group": "grafana",
            "kind": "DataQuery",
            "spec": {},
            "version": "v0"
          }
        }
      }
    ],
    "cursorSync": "Off",
    "editable": true,
    "elements": {
      "panel-70": {
        "kind": "Panel",
        "spec": {
          "id": 70,
          "title": "Recent traces",
          "description": "Feature traces for the selected service. Health checks, metrics scrapes, and readiness probes are left out. There is no service map. The trace id cell opens the trace. A missing row means the process has no OTEL_EXPORTER_OTLP_ENDPOINT, Alloy is down, or only probes ran.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "refId": "A",
                    "query": {
                      "kind": "DataQuery",
                      "group": "tempo",
                      "version": "v0",
                      "datasource": {
                        "name": "tempo",
                        "uid": "tempo"
                      },
                      "spec": {
                        "filters": [],
                        "limit": 20,
                        "query": "{ resource.service.name =~ \"$service\" && rootName !~ \"^(GET|HEAD|POST) /(health|metrics).*\" && rootName !~ \"^(GET|HEAD) /(ready|live|-/healthy|-/ready|_stcore/health).*\" }",
                        "queryType": "traceql",
                        "tableType": "traces"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.2.3",
            "spec": {
              "options": {
                "cellHeight": "sm",
                "showHeader": true,
                "footer": {
                  "countRows": false,
                  "enablePagination": false,
                  "fields": "",
                  "reducer": [
                    "sum"
                  ],
                  "show": false
                }
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "panel-71": {
        "kind": "Panel",
        "spec": {
          "id": 71,
          "title": "Search spans slower than 250 ms",
          "description": "Retrieval spans over the 250 ms target. The trace id cell opens the trace. Compare it with the Retrieval and access latency panel. No rows means search is inside the target or nobody searched.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "refId": "A",
                    "query": {
                      "kind": "DataQuery",
                      "group": "tempo",
                      "version": "v0",
                      "datasource": {
                        "name": "tempo",
                        "uid": "tempo"
                      },
                      "spec": {
                        "filters": [],
                        "limit": 20,
                        "query": "{ resource.service.name =~ \"$service\" && name = \"retrieval\" && duration > 250ms }",
                        "queryType": "traceql",
                        "tableType": "traces"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.2.3",
            "spec": {
              "options": {
                "cellHeight": "sm",
                "showHeader": true,
                "footer": {
                  "countRows": false,
                  "enablePagination": false,
                  "fields": "",
                  "reducer": [
                    "sum"
                  ],
                  "show": false
                }
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "panel-72": {
        "kind": "Panel",
        "spec": {
          "id": 72,
          "title": "Error spans",
          "description": "Feature spans marked error. Health checks, metrics scrapes, and readiness probes are left out. The trace id cell opens the trace, then the log line with the same trace id. A deny is not an error span. An error here is a failed call, a store exception, or an HTTP 5xx.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "refId": "A",
                    "query": {
                      "kind": "DataQuery",
                      "group": "tempo",
                      "version": "v0",
                      "datasource": {
                        "name": "tempo",
                        "uid": "tempo"
                      },
                      "spec": {
                        "filters": [],
                        "limit": 20,
                        "query": "{ resource.service.name =~ \"$service\" && status = error && rootName !~ \"^(GET|HEAD|POST) /(health|metrics).*\" && rootName !~ \"^(GET|HEAD) /(ready|live|-/healthy|-/ready|_stcore/health).*\" }",
                        "queryType": "traceql",
                        "tableType": "traces"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.2.3",
            "spec": {
              "options": {
                "cellHeight": "sm",
                "showHeader": true,
                "footer": {
                  "countRows": false,
                  "enablePagination": false,
                  "fields": "",
                  "reducer": [
                    "sum"
                  ],
                  "show": false
                }
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "panel-73": {
        "kind": "Panel",
        "spec": {
          "id": 73,
          "title": "Chat turns",
          "description": "Traces whose root is chat.turn. Open a trace id to see the gateway, the router, retrieval, and the stores in the same trace. Ingestion of an object is a different trace: the connector starts it and the worker continues it from the SQS traceparent. Find that one in Explore with { span.source_id = \"hr\" }. No rows means the page has no OTEL_EXPORTER_OTLP_ENDPOINT or nobody asked.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "refId": "A",
                    "query": {
                      "kind": "DataQuery",
                      "group": "tempo",
                      "version": "v0",
                      "datasource": {
                        "name": "tempo",
                        "uid": "tempo"
                      },
                      "spec": {
                        "filters": [],
                        "limit": 20,
                        "query": "{ resource.service.name = \"chat-ui\" && name = \"chat.turn\" }",
                        "queryType": "traceql",
                        "tableType": "traces"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.2.3",
            "spec": {
              "options": {
                "cellHeight": "sm",
                "showHeader": true,
                "footer": {
                  "countRows": false,
                  "enablePagination": false,
                  "fields": "",
                  "reducer": [
                    "sum"
                  ],
                  "show": false
                }
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "panel-74": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "loki",
                        "uid": "loki"
                      },
                      "group": "loki",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "{service=\"chat-ui\"} | json | trace_id=~\"${trace_id}\"",
                        "queryType": "range"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Chat lines for the trace id variable. .+ shows every chat line that has a trace id. Paste a trace id from the chat caption to keep one turn. The trace_id field opens the Tempo trace. The line has the persona and the route, and it has no question and no token.",
          "id": 74,
          "links": [],
          "title": "Chat logs for a trace",
          "vizConfig": {
            "group": "logs",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              },
              "options": {
                "dedupStrategy": "none",
                "enableInfiniteScrolling": false,
                "enableLogDetails": true,
                "prettifyLogMessage": false,
                "showCommonLabels": false,
                "showControls": false,
                "showFieldSelector": false,
                "showLabels": true,
                "showLevel": true,
                "showTime": true,
                "sortOrder": "Descending",
                "timestampResolution": "ms",
                "unwrappedColumns": false,
                "wrapLogMessage": true
              }
            },
            "version": "13.2.3"
          }
        }
      }
    },
    "layout": {
      "kind": "RowsLayout",
      "spec": {
        "rows": [
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "collapse": false,
              "hideHeader": false,
              "title": "Traces",
              "layout": {
                "kind": "GridLayout",
                "spec": {
                  "items": [
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "x": 0,
                        "y": 0,
                        "width": 24,
                        "height": 10,
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-70"
                        }
                      }
                    },
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "x": 0,
                        "y": 10,
                        "width": 12,
                        "height": 10,
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-71"
                        }
                      }
                    },
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "x": 12,
                        "y": 10,
                        "width": 12,
                        "height": 10,
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-72"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "collapse": false,
              "title": "Chat",
              "layout": {
                "kind": "GridLayout",
                "spec": {
                  "items": [
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-73"
                        },
                        "height": 10,
                        "width": 12,
                        "x": 0,
                        "y": 0
                      }
                    },
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-74"
                        },
                        "height": 10,
                        "width": 12,
                        "x": 12,
                        "y": 0
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "links": [
      {
        "title": "Ingestion",
        "type": "link",
        "icon": "external link",
        "tooltip": "Per-source sync, queues, store writes, and product hooks",
        "url": "/d/kbs-ingestion/kbs-ingestion",
        "tags": [],
        "asDropdown": false,
        "targetBlank": false,
        "includeVars": true,
        "keepTime": true
      },
      {
        "title": "Retrieval and access",
        "type": "link",
        "icon": "external link",
        "tooltip": "HTTP, search latency, empty results, and denies",
        "url": "/d/kbs-retrieval-access/kbs-retrieval-access",
        "tags": [],
        "asDropdown": false,
        "targetBlank": false,
        "includeVars": true,
        "keepTime": true
      }
    ],
    "liveNow": false,
    "preload": false,
    "tags": [
      "kbs",
      "traces"
    ],
    "timeSettings": {
      "autoRefresh": "",
      "autoRefreshIntervals": [
        "5s",
        "10s",
        "30s",
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "2h",
        "1d"
      ],
      "fiscalYearStartMonth": 0,
      "from": "now-15m",
      "hideTimepicker": false,
      "timezone": "browser",
      "to": "now"
    },
    "title": "KBS / Traces",
    "variables": [
      {
        "kind": "QueryVariable",
        "spec": {
          "name": "service",
          "label": "Service",
          "description": "TraceQL filter on resource.service.name. All is .+ so an empty match is not sent.",
          "hide": "dontHide",
          "refresh": "onDashboardLoad",
          "skipUrlSync": false,
          "current": {
            "text": "All",
            "value": "$__all"
          },
          "options": [],
          "regex": "",
          "sort": "alphabeticalAsc",
          "multi": false,
          "includeAll": true,
          "allValue": ".+",
          "allowCustomValue": false,
          "query": {
            "kind": "DataQuery",
            "group": "prometheus",
            "version": "v0",
            "datasource": {
              "name": "prometheus",
              "uid": "prometheus"
            },
            "spec": {
              "query": "label_values(up, job)",
              "refId": "A"
            }
          }
        }
      },
      {
        "kind": "TextVariable",
        "spec": {
          "name": "trace_id",
          "label": "Trace id",
          "description": "Paste a trace id from the chat caption. .+ shows every chat line.",
          "hide": "dontHide",
          "skipUrlSync": false,
          "current": {
            "text": ".+",
            "value": ".+"
          },
          "query": ".+"
        }
      }
    ]
  }
}
