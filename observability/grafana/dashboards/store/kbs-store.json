      "panel-11": {
        "kind": "Panel",
        "spec": {
          "id": 11,
          "title": "Recent traces",
          "description": "Store spans inside the worker and the gateway. Postgres is authoritative. Neo4j is the derived graph.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "refId": "A",
                    "query": {
                      "kind": "DataQuery",
                      "group": "tempo",
                      "version": "v0",
                      "datasource": {
                        "name": "tempo",
                        "uid": "tempo"
                      },
                      "spec": {
                        "filters": [],
                        "limit": 20,
                        "query": "{ resource.service.name =~ \"ingestion-worker|gateway-api|gateway-mcp\" && name =~ \"postgres.commit|neo4j.write|embed.query|chunks.vector|chunks.full_text|delete.verify\" }",
                        "queryType": "traceql",
                        "tableType": "traces"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.2.3",
            "spec": {
