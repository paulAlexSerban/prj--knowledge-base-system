                        <mxPoint x="115" y="190" as="sourcePoint"/>
                        <mxPoint x="360" y="190" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="m2" value="2. the same call" style="endArrow=block;endFill=1;html=1;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontFamily=Courier New;fontSize=11;labelBackgroundColor=#000000;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="360" y="260" as="sourcePoint"/>
                        <mxPoint x="605" y="260" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="m3" value="3. validate HS256; build the principal (groups, clearance, department)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontFamily=Courier New;fontSize=11;align=center;" parent="1" vertex="1">
                    <mxGeometry x="470" y="290" width="400" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="s1" value="4. SQL pre-filter, &lt;br&gt;row-level security, &lt;br&gt;vector and full-text, &lt;br&gt;limit times 3" style="endArrow=block;endFill=1;html=1;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontFamily=Courier New;fontSize=11;labelBackgroundColor=#000000;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="605" y="430" as="sourcePoint"/>
                        <mxPoint x="850" y="430" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="s2" value="5. RRF k=60; distance floor 0.40; one rule must match; one chunk per object" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontFamily=Courier New;fontSize=11;align=center;" parent="1" vertex="1">
                    <mxGeometry x="430" y="470" width="480" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="s3" value="6. HR policy only: &lt;br&gt;GET /policies/{id}/acl. &lt;br&gt;A timeout or a bad body returns nothing." style="endArrow=block;endFill=1;html=1;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontFamily=Courier New;fontSize=11;labelBackgroundColor=#000000;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="605" y="560" as="sourcePoint"/>
                        <mxPoint x="1340" y="560" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="s4" value="7. insert an audit row. &lt;br&gt;gateway_ro cannot read it." style="endArrow=block;endFill=1;html=1;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontFamily=Courier New;fontSize=11;labelBackgroundColor=#000000;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="605" y="640" as="sourcePoint"/>
                        <mxPoint x="850" y="640" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
