                <mxCell id="g2" value="10. one acl_rules element must match. No harness call." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontFamily=Courier New;fontSize=11;align=center;" parent="1" vertex="1">
