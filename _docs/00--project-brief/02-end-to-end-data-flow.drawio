ica;fontSize=11;arcSize=6;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1"><mxGeometry x="660" y="144" width="220" height="150" as="geometry"/></mxCell><mxCell id="n_sqs" value="&lt;b&gt;SQS FIFO per tier&lt;/b&gt;&lt;br&gt;P0 HR body and any ACL change&lt;br&gt;P1 Sales, Eng, Product&lt;br&gt;P2 backfill, reconcile&lt;br&gt;group = source id + object id&lt;br&gt;kbs-product-hooks&lt;br&gt;&amp;nbsp;&lt;br&gt;dead-letter queue per queue&lt;br&gt;after 5 receives; make dlq-replay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1061B0;strokeColor=#0B4884;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;arcSize=6;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1"><mxGeometry x="660" y="324" width="220" height="380" as="geometry"/></mxCell><mxCell id="n_sched" value="&lt;b&gt;Scheduler (production path)&lt;/b&gt;&lt;br&gt;P1/P2 polls and reconcile&lt;br&gt;P0 poll stays in the connector&lt;br&gt;(one-minute minimum)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#BBBBBB;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;arcSize=6;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1"><mxGeometry x="660" y="734" width="220" height="150" as="geometry"/></mxCell><mxCell id="n_g_wrk" value="&lt;b&gt;ingestion-worker (queue consumer)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;dashed=1;dashPattern=8 4;strokeWidth=2;arcSize=3;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="950" y="70" width="290" height="840" as="geometry"/></mxCell><mxCell id="n_w1" value="&lt;b&gt;1 receive, drain P0 then P1, P2&lt;/b&gt;&lt;br&gt;fetch snapshot, check hash&lt;br&gt;tombstone blocks stale events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1061B0;strokeColor=#0B4884;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;arcSize=6;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1"><mxGeometry x="970" y="144" width="250" height="125" as="geometry"/></mxCell><mxCell id="n_w2" value="&lt;b&gt;2 chunk&lt;/b&gt;&lt;br&gt;markdown by heading, pdf by&lt;br&gt;paragraph, record = one chunk&lt;br&gt;chunker_version recorded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1061B0;strokeColor=#0B4884;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;arcSize=6;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1"><mxGeometry x="970" y="294" width="250" height="125" as="geometry"/></mxCell><mxCell id="n_w3" value="&lt;b&gt;3 embed&lt;/b&gt;&lt;br&gt;bge-small via fastembed, 384 d&lt;br&gt;skipped when content hash same&lt;br&gt;embedding_model recorded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1061B0;strokeColor=#0B4884;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;arcSize=6;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1"><mxGeometry x="970" y="444" width="250" height="125" as="geometry"/></mxCell><mxCell id="n_w4" value="&lt;b&gt;4 commit Postgres&lt;/b&gt;&lt;br&gt;chunks, vector, full-text, ACL&lt;br&gt;delete: tombstone + hard delete" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1061B0;strokeColor=#0B4884;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;arcSize=6;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1"><mxGeometry x="970" y="594" width="250" height="125" as="geometry"/></mxCell><mxCell id="n_w5" value="&lt;b&gt;5 merge Neo4j&lt;/b&gt;&lt;br&gt;edges from structured records&lt;br&gt;failure leaves message unacked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1061B0;strokeColor=#0B4884;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;arcSize=6;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1"><mxGeometry x="970" y="744" width="250" height="125" as="geometry"/></mxCell><mxCell id="n_g_data" value="&lt;b&gt;Knowledge store (internal network)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13