 width="280" height="90" as="geometry"/></mxCell><mxCell id="n_mcp" value="&lt;b&gt;mcp-server&lt;/b&gt;&lt;br&gt;search_knowledge, get_document,&lt;br&gt;find_related, list_sources" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1061B0;strokeColor=#0B4884;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;arcSize=6;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1"><mxGeometry x="1650" y="254" width="280" height="90" as="geometry"/></mxCell><mxCell id="n_core" value="&lt;b&gt;gateway-core (one service layer)&lt;/b&gt;&lt;br&gt;1 validate JWT, build principal&lt;br&gt;   (groups, clearance, department)&lt;br&gt;2 hybrid search: pgvector cosine +&lt;br&gt;   full-text, reciprocal rank fusion,&lt;br&gt;   similarity floor, one chunk/object&lt;br&gt;3 graph templates (read-only session)&lt;br&gt;4 coarse pre-filter in SQL and Cypher&lt;br&gt;5 fine post-check of one ACL rule&lt;br&gt;6 row-level security&lt;br&gt;7 audit row names the attributes&lt;br&gt;8 HR policy: live ACL re-check&lt;br&gt;   at the harness, fail closed&lt;br&gt;9 wrap snippet as untrusted data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1061B0;strokeColor=#0B4884;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;arcSize=6;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1"><mxGeometry x="1650" y="374" width="280" height="520" as="geometry"/></mxCell><mxCell id="n_g_ag" value="&lt;b&gt;Callers (hold no store credentials)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=13;dashed=1;dashPattern=8 4;strokeWidth=2;arcSize=3;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="2000" y="70" width="280" height="840" as="geometry"/></mxCell><mxCell id="n_chat" value="&lt;b&gt;chat-ui (Streamlit)&lt;/b&gt;&lt;br&gt;persona token&lt;br&gt;suggested question 2 uses&lt;br&gt;roadmap_deals, typed uses search&lt;br&gt;writes answer from citations" style="rounded=1;whi