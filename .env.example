# Dev-only values. Copy to .env. Do not use these passwords anywhere else.
POSTGRES_PASSWORD="dev-only-change-me"
INGESTION_DB_PASSWORD="dev-only-ingestion"
GATEWAY_DB_PASSWORD="dev-only-gateway"
NEO4J_PASSWORD="dev-only-change-me"
# Dev only. HS256 secret for the mock identity provider. Not an OIDC issuer.
GATEWAY_JWT_SECRET="dev-only-gateway-jwt-secret-change-me"
# Compose leaves POST /dev/token off unless this is 1. The local demo turns it on.
DEV_TOKEN_ENDPOINT="1"

AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"
AWS_DEFAULT_REGION="us-east-1"
# Host tools talk to the published port. Containers use http://floci:4566.
AWS_ENDPOINT_URL="http://127.0.0.1:4566"

# Embedding model for ingestion and search. fastembed is multilingual-e5-large
# (1024 dimensions, semantic, baked into the images, about 2.2 GB per image).
# hash is deterministic and lexical: tests and offline runs use it.
# Changing this value needs `make reindex`. See ADR 0005.
EMBEDDER="fastembed"
# Cosine distance above which a vector-only hit is dropped.
# e5-large on the seeded chunks: paraphrases about 0.11 to 0.18,
# "xylophone quantum payroll" about 0.21.
VECTOR_MAX_DISTANCE="0.20"
# Optional classifier for low-confidence questions. Unused when the key is empty.
# Rules still decide high-confidence questions, and any model failure falls back to them.
OPENROUTER_ROUTER_MODEL="openai/gpt-4o-mini"

# Optional. Set to one object id to make the ingestion worker reject that message
# until it lands on the dead-letter queue. Unset it before `make dlq-replay`.
FAIL_OBJECT_ID=""

# Optional. Offline stubs do not call a model.
OPENROUTER_API_KEY=""
# Chat model for the chat page. Used only when the key is set.
OPENROUTER_MODEL="openai/gpt-4o-mini"

# Jupyter on port 8888. Dev only.
JUPYTER_TOKEN="dev-only-notebook"

# Grafana on port 3000. Dev only. User is admin.
GRAFANA_ADMIN_PASSWORD="admin"
